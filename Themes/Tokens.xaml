<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        主题令牌（浅色为默认值）。
        运行时由 Services/ThemeService.cs 统一重写这些键，深色值定义在那里，
        两者保持一致：ThemeService 的调色板是唯一事实来源。
    -->

    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="FluentFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- 表面层级：外壳 → 内容面 → 内嵌控件 -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F1F2F4" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="SectionBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SectionBrush2" Color="#EDEFF3" />
    <SolidColorBrush x:Key="SearchBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBrush" Color="#EFF1F4" />
    <SolidColorBrush x:Key="CardBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="IconTileBrush" Color="#E9ECF1" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextBrush" Color="#1A1B1E" />
    <SolidColorBrush x:Key="SubTextBrush" Color="#5F6368" />

    <!-- 描边 -->
    <SolidColorBrush x:Key="BorderBrush2" Color="#E2E5EA" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD0D8" />

    <!-- 强调色（跟随系统，可被 ThemeService 重写） -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#005A9E" />
    <SolidColorBrush x:Key="SoftAccentBrush" Color="#1A0078D4" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#330078D4" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#520078D4" />
    <SolidColorBrush x:Key="HoverBrush" Color="#1E0078D4" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2E0078D4" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#500078D4" />

    <!-- 语义色 -->
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1AC42B1C" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9A6700" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1F9A6700" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#1A0F6CBD" />

    <!-- 滚动条 -->
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C2C7CE" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A5AAB3" />
    <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#888E97" />

    <!-- 弹出层 -->
    <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#DFE3E8" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#1C000000" />

    <!-- 其他 -->
    <SolidColorBrush x:Key="TrackBrush" Color="#E4E7EC" />
    <SolidColorBrush x:Key="KeyCapBrush" Color="#E8EBEF" />
    <SolidColorBrush x:Key="KeyCapBorderBrush" Color="#D9DEE5" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#38000000" />
    <Color x:Key="ShadowColor">#000000</Color>

</ResourceDictionary>