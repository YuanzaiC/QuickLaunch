<Window x:Class="QuickLaunch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickLaunch 设置"
        Icon="{StaticResource AppIcon}"
        Width="1060" Height="740" MinWidth="960" MinHeight="660"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent" AllowsTransparency="True"
        BorderThickness="0" Padding="0" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        ToolTipService.InitialShowDelay="420">
    <Window.Resources>
        <!-- 左侧导航项：选中时左侧出现强调色标记 -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="11"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Border x:Name="Marker"
                                    Width="3" Height="20"
                                    CornerRadius="2"
                                    Margin="1,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置卡片：内容面比外壳亮一档，浅色下不会出现“白底白块” -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FluentFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 阴影层（独立元素，保证正文保持 ClearType） -->
        <Border Margin="16,20,16,14"
                CornerRadius="22"
                Background="{DynamicResource ShadowBrush}"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.9" />
            </Border.Effect>
        </Border>

        <Border Margin="16"
                CornerRadius="22"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush2}"
                BorderThickness="1">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= 左侧导航 ================= -->
                <Grid Grid.Column="0" Margin="8,10,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="SidebarGrip" Height="70" Background="Transparent">
                        <StackPanel Margin="8,6,0,0" IsHitTestVisible="False">
                            <TextBlock Text="QuickLaunch" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="设置中心" FontSize="11.5" Margin="0,3,0,0" Foreground="{DynamicResource SubTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <TextBlock Text="设置" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="14,0,0,8" />
                        <RadioButton x:Name="ScanNav" Tag="扫描与索引" Style="{StaticResource NavButton}" GroupName="Settings" IsChecked="True" Checked="Nav_Checked" AutomationProperties.Name="扫描与索引">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" />
                                <TextBlock Text="扫描与索引" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Tag="外观与行为" Style="{StaticResource NavButton}" GroupName="Settings" Checked="Nav_Checked" AutomationProperties.Name="外观与行为">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE771;" Style="{StaticResource IconText}" />
                                <TextBlock Text="外观与行为" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Tag="维护与数据" Style="{StaticResource NavButton}" GroupName="Settings" Checked="Nav_Checked" AutomationProperties.Name="维护与数据">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" />
                                <TextBlock Text="维护与数据" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Tag="关于 QuickLaunch" Style="{StaticResource NavButton}" GroupName="Settings" Checked="Nav_Checked" AutomationProperties.Name="关于 QuickLaunch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" />
                                <TextBlock Text="关于 QuickLaunch" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <Border Grid.Row="2" Margin="4,0,4,4" CornerRadius="12"
                            Background="{DynamicResource SectionBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}"
                            BorderThickness="1"
                            Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="快速呼出" FontSize="11" Foreground="{DynamicResource SubTextBrush}" />
                            <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <TextBlock Text="{Binding Hotkey}" Style="{StaticResource KeyCapText}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14" />

                <!-- ================= 右侧内容 ================= -->
                <Grid Grid.Column="2" Margin="26,14,26,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="HeaderGrip" Height="64" Background="Transparent">
                        <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock x:Name="PageTitle" Text="扫描与索引" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="管理 QuickLaunch 的扫描位置、外观和行为" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource CloseIconButton}" Width="40" Height="40"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="Close_Click" ToolTip="关闭设置（Esc）" AutomationProperties.Name="关闭设置" AutomationProperties.AutomationId="CloseSettings">
                            <TextBlock Text="&#xE711;" FontFamily="{DynamicResource FluentFont}" FontSize="15" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,0,12,0">
                            <!-- 扫描与索引 -->
                            <StackPanel x:Name="ScanPage">
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource SoftAccentBrush}">
                                                <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource FluentFont}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="扫描文件夹" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="QuickLaunch 会在这些位置寻找 .exe 和 .lnk 文件。" Style="{StaticResource Description}" Margin="0,8,0,14" />

                                        <Border Background="{DynamicResource ControlBrush}"
                                                BorderBrush="{DynamicResource BorderBrush2}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="4">
                                            <Grid>
                                                <ListBox x:Name="FolderList" ItemsSource="{Binding ScanFolders}" Height="152" Background="Transparent" BorderThickness="0">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource FluentFont}" FontSize="14" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="还没有添加扫描目录"
                                                           Foreground="{DynamicResource SubTextBrush}"
                                                           FontSize="12.5"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding ScanFolders.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Style="{StaticResource SecondaryButton}" Click="AddFolder_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="{DynamicResource FluentFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="添加文件夹" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="RemoveFolder_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE738;" FontFamily="{DynamicResource FluentFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="移除选中" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource SoftAccentBrush}">
                                                <TextBlock Text="&#xE71C;" FontFamily="{DynamicResource FluentFont}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="扫描规则" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <CheckBox Content="递归扫描子文件夹" IsChecked="{Binding Recursive}" Margin="0,16,0,16" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="最大递归深度" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding MaxDepth, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="2" Text="0 表示只扫描当前目录" Foreground="{DynamicResource SubTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>

                                        <TextBlock Text="包含的扩展名（逗号分隔）" Style="{StaticResource Description}" Margin="0,16,0,6" />
                                        <TextBox Style="{StaticResource InputBox}" Text="{Binding IncludeExtensionsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如：.exe, .lnk" />

                                        <TextBlock Text="排除的文件夹（逗号分隔）" Style="{StaticResource Description}" Margin="0,16,0,6" />
                                        <TextBox Style="{StaticResource InputBox}" Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 外观与行为 -->
                            <StackPanel x:Name="BehaviorPage" Visibility="Collapsed">
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource SoftAccentBrush}">
                                                <TextBlock Text="&#xE765;" FontFamily="{DynamicResource FluentFont}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="快速呼出快捷键" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="点击下面的输入框，然后按下你希望使用的组合键；至少需要一个 Ctrl、Alt、Shift 或 Win 修饰键。" Style="{StaticResource Description}" Margin="0,8,0,14" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- 这个框是固定高度（42），必须把纵向内边距压到 0：
                                 InputBox 默认的 Padding 11,8 会把内容区压到 26 以内，
                                 单行文字放不下就只露出顶部一条，看起来像“文字显示不全”。 -->
                                            <TextBox x:Name="HotkeyBox" Grid.Column="0" Height="42" FontSize="15" FontWeight="SemiBold"
                                                     Padding="11,0"
                                                     IsReadOnly="True" IsTabStop="True"
                                                     Style="{StaticResource InputBox}"
                                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                     GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                                     ToolTip="点击后按下快捷键组合" />
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Content="恢复 Alt + Space" Click="ResetHotkey_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource SoftAccentBrush}">
                                                <TextBlock Text="&#xE790;" FontFamily="{DynamicResource FluentFont}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="外观" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="主题会立即应用到主界面和本窗口，取消设置则恢复原来的主题。" Style="{StaticResource Description}" Margin="0,8,0,14" />
                                        <ComboBox Width="220" HorizontalAlignment="Left"
                                                  SelectedValue="{Binding Theme}" SelectedValuePath="Tag"
                                                  SelectionChanged="Theme_SelectionChanged">
                                            <ComboBoxItem Content="跟随系统" Tag="system" />
                                            <ComboBoxItem Content="浅色" Tag="light" />
                                            <ComboBoxItem Content="深色" Tag="dark" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource SoftAccentBrush}">
                                                <TextBlock Text="&#xE7E8;" FontFamily="{DynamicResource FluentFont}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="启动与记录" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <CheckBox Content="Windows 登录后自动启动" IsChecked="{Binding StartWithWindows}" Margin="0,16,0,0" />
                                        <CheckBox Content="最小化时在托盘中显示" IsChecked="{Binding MinimizeToTray}" Margin="0,14,0,0" />
                                        <TextBlock Text="勾选后，收起面板（Esc、点击界面外或“隐藏面板”）时会保留托盘图标，双击即可再次呼出；取消勾选则不在托盘显示，仅用快捷键呼出。"
                                                   Style="{StaticResource Description}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="最近使用最多保留" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding MaxRecent, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="2" Text="条" Foreground="{DynamicResource SubTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 维护与数据 -->
                            <StackPanel x:Name="MaintenancePage" Visibility="Collapsed">
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="图标缓存" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="删除已经生成的图标缓存，下次扫描时会自动重新生成。" Style="{StaticResource Description}" Margin="0,6,0,14" />
                                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="ClearCache_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource FluentFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="清理图标缓存" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="失效项目" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="删除目标文件已经不存在的项目。" Style="{StaticResource Description}" Margin="0,6,0,14" />
                                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="CleanBroken_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource FluentFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="扫描并清理失效项目" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="隐藏项目" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="恢复所有被手动隐藏的项目。" Style="{StaticResource Description}" Margin="0,6,0,14" />
                                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="RestoreHidden_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7B3;" FontFamily="{DynamicResource FluentFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="恢复所有隐藏项目" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="配置文件" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="导入或导出 config.json，用于备份和迁移设置。" Style="{StaticResource Description}" Margin="0,6,0,14" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SecondaryButton}" Click="Import_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" FontFamily="{DynamicResource FluentFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="导入 config.json" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Export_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE898;" FontFamily="{DynamicResource FluentFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="导出 config.json" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="退出程序" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="完全退出 QuickLaunch：不再驻留后台，快捷键也会一并失效。" Style="{StaticResource Description}" Margin="0,6,0,14" />
                                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="ExitApp_Click"
                                                AutomationProperties.Name="退出 QuickLaunch">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource FluentFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="退出 QuickLaunch" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 关于 -->
                            <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource SoftAccentBrush}">
                                            <TextBlock Text="&#xE8FD;" FontFamily="{DynamicResource FluentFont}" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="QuickLaunch" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Text="Windows 11 风格的快速启动面板" Style="{StaticResource Description}" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="运行环境" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text=".NET 8 · WPF · MVVM" Style="{StaticResource Description}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="数据位置" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="配置、图标缓存与日志都保存在程序目录下。" Style="{StaticResource Description}" Margin="0,6,0,14" />
                                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OpenDataFolder_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource FluentFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="打开程序目录" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="0,12,0,0"
                            BorderBrush="{DynamicResource BorderBrush2}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock Text="保存后会立即刷新索引并应用相关设置" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Content="取消" MinWidth="92" Height="40" Click="Close_Click" />
                                <Button Style="{StaticResource PrimaryButton}" Content="保存设置" MinWidth="116" Height="40" Margin="8,0,0,0" Click="Save_Click" />
                            </StackPanel>
                        </Grid>
