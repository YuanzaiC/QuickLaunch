{
  "scanFolders": [
    "C:\\Users\\Public\\Desktop",
    "D:\\Tools"
  ],
  "recursive": true,
  "maxDepth": 3,
  "includeExtensions": [
    ".exe",
    ".lnk"
  ],
  "excludeFolders": [
    "node_modules",
    "$Recycle.Bin"
