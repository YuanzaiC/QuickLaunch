<Window x:Class="QuickLaunch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickLaunch"
        Icon="{StaticResource AppIcon}"
        Width="920" Height="700" MinWidth="760" MinHeight="540"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" FontFamily="{DynamicResource AppFont}"
        AllowsTransparency="True" ShowActivated="False" BorderThickness="0" Padding="0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        ToolTipService.InitialShowDelay="420">
    <Window.Resources>
        <Geometry x:Key="AppLogoGeometry">M3,9 L9,3 L13,7 L7,13 Z M11,15 L15,11 L21,17 L17,21 Z M15,3 L21,9 L17,13 L11,7 Z M3,15 L9,21 L13,17 L7,11 Z</Geometry>
        <Geometry x:Key="FolderGeometry">M2,5 C2,3.9 2.9,3 4,3 H9 L11,5 H20 C21.1,5 22,5.9 22,7 V18 C22,19.1 21.1,20 20,20 H4 C2.9,20 2,19.1 2,18 Z</Geometry>
        <Geometry x:Key="SearchGeometry">M10.5,3 A7.5,7.5 0 1 0 10.5,18 A7.5,7.5 0 1 0 10.5,3 M16,16 L21,21</Geometry>

        <CollectionViewSource x:Key="GroupedItems" Source="{Binding FilteredItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="DisplayGroup" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- 内容面：浅色下是纯白卡片，外壳是浅灰，两者不会再糊在一起 -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 分组标题（文件夹）：整条可点击展开/折叠 -->
        <Style x:Key="GroupItemContainer" TargetType="GroupItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <Expander Style="{StaticResource ModernExpander}" IsExpanded="True">
                            <Expander.Header>
                                <Grid Margin="2,1" MinHeight="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource SoftAccentBrush}">
                                            <Path Data="{StaticResource FolderGeometry}" Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Border Style="{StaticResource KeyCap}" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource KeyCapText}">
                                                <TextBlock.Text>
                                                    <Binding Path="ItemCount" StringFormat="{}{0} 项" />
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="&#xE70D;"
                                                   FontFamily="{DynamicResource FluentFont}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   VerticalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </TextBlock.RenderTransform>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.18">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.18">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <ItemsPresenter />
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 应用列表项：悬停只是鼠标经过的效果；选中仅用于“键盘光标”和右键菜单打开期间，平时不留痕迹 -->
        <Style x:Key="AppCard" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Focusable" Value="True" />
            <!-- 自绘高亮，不要 WPF 默认的虚线焦点框 -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="6,4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="AccentBar"
                                    Width="3" Height="26"
                                    CornerRadius="2"
                                    Margin="1,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Loaded" Handler="AppCard_Loaded" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="AppCard_MouseLeftButtonUp" />
            <EventSetter Event="ContextMenuOpening" Handler="AppCard_ContextMenuOpening" />
        </Style>

        <DataTemplate x:Key="AppItemTemplate">
            <Grid MinHeight="62">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource IconTileBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image Source="{Binding Icon}" Width="30" Height="30" Stretch="Uniform" SnapsToDevicePixels="True" UseLayoutRounding="True" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding Path}" FontSize="11.5" Margin="0,3,0,0" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Margin="0,0,6,0"
                           Text="{Binding IsBroken, Converter={StaticResource BooleanToWarning}}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontFamily="{DynamicResource FluentFont}"
                           FontSize="16"
                           Foreground="{DynamicResource DangerBrush}"
                           ToolTip="目标文件已不存在" />
            </Grid>
        </DataTemplate>

        <!-- 收藏 / 最近使用 的小卡片：单击启动，右键菜单与主列表完全一致 -->
        <DataTemplate x:Key="SmallItemTemplate">
            <Button Tag="{Binding}"
                    Style="{StaticResource TileButton}"
                    Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Loaded="Tile_Loaded"
                    ContextMenuOpening="Tile_ContextMenuOpening"
                    Width="140" Height="92" Margin="0,0,10,0"
                    ToolTip="{Binding Path}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12"
                            Background="{DynamicResource SectionBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="28" Height="28" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="{Binding Name}" Width="120" Height="30" Margin="0,8,0,0"
                               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               FontSize="12" Foreground="{DynamicResource TextBrush}" ToolTip="{Binding Name}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- 阴影单独画在一层上，避免给内容加 Effect 导致文字失去 ClearType -->
        <Border Margin="16,20,16,14"
                CornerRadius="22"
                Background="{DynamicResource ShadowBrush}"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.9" />
            </Border.Effect>
        </Border>

        <Border x:Name="RootPanel"
                Margin="16"
                CornerRadius="22"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush2}"
                BorderThickness="1">
            <Grid Margin="20,16,20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶栏：空白处按住即可拖动窗口（交互控件会自动跳过）
                     注意：Grid 只有设置了 Background 才会参与命中测试，否则拖动会失效 -->
                <Grid x:Name="DragArea" Grid.Row="0" Height="56" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,16,0" IsHitTestVisible="False">
                        <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource SoftAccentBrush}">
                            <Path Data="{StaticResource AppLogoGeometry}" Fill="{DynamicResource AccentBrush}" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="QuickLaunch" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="按住此处拖动窗口" FontSize="10.5" Margin="0,1,0,0" Foreground="{DynamicResource SubTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="SearchHost" Grid.Column="1" Height="44" CornerRadius="13" Padding="14,0" VerticalAlignment="Center"
                            Background="{DynamicResource SearchBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}"
                            BorderThickness="1"
                            Tag="no-drag">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource SearchGeometry}" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="15" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Padding="0" ToolTip="搜索名称、路径或拼音首字母" AutomationProperties.Name="搜索应用" />
                            <Border Grid.Column="2" Style="{StaticResource KeyCap}" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                                <TextBlock Text="Ctrl+F" Style="{StaticResource KeyCapText}" />
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{StaticResource IconButton}" Width="40" Height="40" ToolTip="设置" Click="Settings_Click" AutomationProperties.Name="打开设置">
                            <TextBlock Text="&#xE713;" FontFamily="{DynamicResource FluentFont}" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="40" Height="40" Margin="6,0,0,0" ToolTip="隐藏面板（Esc）" Click="Hide_Click" AutomationProperties.Name="隐藏面板">
                            <TextBlock Text="&#xED1A;" FontFamily="{DynamicResource FluentFont}" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 内容 -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <ScrollViewer x:Name="ContentScroll"
                                  Margin="0,0,2,0"
                                  PreviewMouseWheel="ContentScroll_PreviewMouseWheel"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  PanningMode="VerticalOnly"
                                  IsDeferredScrollingEnabled="True">
                        <StackPanel Margin="0,0,10,0">
                            <StackPanel x:Name="PinnedSections">
                                <Border Style="{StaticResource SectionCard}" Visibility="{Binding Favorites.Count, Converter={StaticResource CountToVisibility}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource SoftAccentBrush}">
                                                    <TextBlock Text="&#xE735;" FontFamily="{DynamicResource FluentFont}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="收藏" Style="{StaticResource CardTitle}" />
                                                    <TextBlock Text="固定常用应用" FontSize="10.5" Margin="0,1,0,0" Foreground="{DynamicResource SubTextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Style="{StaticResource KeyCapText}" VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <Binding Path="Favorites.Count" StringFormat="{}{0} 项" />
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                        <ScrollViewer Grid.Row="1"
                                                      Margin="0,12,0,2"
                                                      PreviewMouseWheel="ContentScroll_PreviewMouseWheel"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Hidden"
                                                      CanContentScroll="False"
                                                      Focusable="False">
                                            <ItemsControl ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource SmallItemTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SectionCard}" Visibility="{Binding Recents.Count, Converter={StaticResource CountToVisibility}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource SoftAccentBrush}">
                                                    <TextBlock Text="&#xE823;" FontFamily="{DynamicResource FluentFont}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="最近打开" Style="{StaticResource CardTitle}" />
                                                    <TextBlock Text="最近使用的应用" FontSize="10.5" Margin="0,1,0,0" Foreground="{DynamicResource SubTextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Style="{StaticResource KeyCapText}" VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <Binding Path="Recents.Count" StringFormat="{}{0} 项" />
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                        <ScrollViewer Grid.Row="1"
                                                      Margin="0,12,0,2"
                                                      PreviewMouseWheel="ContentScroll_PreviewMouseWheel"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Hidden"
                                                      CanContentScroll="False"
                                                      Focusable="False">
                                            <ItemsControl ItemsSource="{Binding Recents}" ItemTemplate="{StaticResource SmallItemTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Border Style="{StaticResource SectionCard}"
                                    Padding="14,14,14,10"
                                    Visibility="{Binding FilteredItems.Count, Converter={StaticResource CountToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource SoftAccentBrush}">
                                                <TextBlock Text="&#xE8FD;" FontFamily="{DynamicResource FluentFont}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="全部应用" Style="{StaticResource CardTitle}" />
                                                <TextBlock Text="单击或回车启动，右键查看更多操作" FontSize="10.5" Margin="0,1,0,0" Foreground="{DynamicResource SubTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Style="{StaticResource KeyCapText}" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <Binding Path="FilteredItems.Count" StringFormat="{}{0} 项" />
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>

                                    <ListBox x:Name="AppList"
                                             Grid.Row="1"
                                             Margin="0,10,0,0"
                                             ItemsSource="{Binding Source={StaticResource GroupedItems}}"
                                             ItemContainerStyle="{StaticResource AppCard}"
                                             SelectionMode="Single"
                                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.CanContentScroll="True"
                                             Focusable="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                             PreviewMouseLeftButtonDown="AppList_MouseLeftButtonDown"
                                             PreviewMouseLeftButtonUp="AppList_MouseLeftButtonUp"
                                             PreviewMouseMove="AppList_MouseMove"
                                             Drop="AppList_Drop"
                                             AllowDrop="True">
                                        <ListBox.GroupStyle>
                                            <GroupStyle ContainerStyle="{StaticResource GroupItemContainer}">
                                                <GroupStyle.Panel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel />
                                                    </ItemsPanelTemplate>
                                                </GroupStyle.Panel>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                        <ListBox.ItemTemplate>
                                            <StaticResource ResourceKey="AppItemTemplate" />
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 空状态 -->
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="68" Height="68" CornerRadius="20"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource SectionBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"
                                BorderThickness="1">
                            <TextBlock Text="&#xE721;" FontFamily="{DynamicResource FluentFont}" FontSize="26" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="没有找到匹配的应用" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock x:Name="EmptyHint" Text="换个关键词试试" FontSize="12" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 状态栏 -->
                <Border Grid.Row="2" Margin="0,6,0,0" Padding="2,10,2,0"
                        BorderBrush="{DynamicResource BorderBrush2}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                            <ProgressBar Width="120" Maximum="100" Value="{Binding ScanProgress, Mode=OneWay}" VerticalAlignment="Center" Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibility}}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="取消扫描" Padding="10,5" FontSize="12" Margin="10,0,0,0" Click="CancelScan_Click" Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource KeyCap}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HotkeyText}" Style="{StaticResource KeyCapText}" />
                            </Border>
                            <TextBlock Text="呼出" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>